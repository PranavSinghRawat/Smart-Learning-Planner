{
  "info": {
    "name": "Smart Learning Planner – API Tests",
    "_postman_id": "slp-api-test-collection-v2",
    "description": "API test collection for Smart Learning Planner. Covers Health, Auth, Exams (GET), Resources, Smart Plan, and Security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",         "value": "http://localhost:5001", "type": "string" },
    { "key": "token",           "value": "",                      "type": "string" },
    { "key": "dynamicEmail",    "value": "",                      "type": "string" },
    { "key": "dynamicUsername", "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /api/health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
            "pm.test('Response time under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
          ]}}]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register – Success",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "const ts = Date.now();",
                "const email = `user_${ts}@example.com`;",
                "const username = `user_${ts}`;",
                "pm.collectionVariables.set('dynamicEmail', email);",
                "pm.collectionVariables.set('dynamicUsername', username);",
                "pm.request.body.update({",
                "  mode: 'raw',",
                "  raw: JSON.stringify({ username, name: 'Test User', email, password: 'password123' })",
                "});"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 201 – user created', () => pm.response.to.have.status(201));",
                "pm.test('Has token', () => {",
                "  const j = pm.response.json();",
                "  pm.expect(j).to.have.property('token');",
                "  pm.collectionVariables.set('token', j.token);",
                "});",
                "pm.test('User email matches', () => {",
                "  pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('dynamicEmail'));",
                "});",
                "pm.test('Password not exposed', () => {",
                "  pm.expect(pm.response.json().user).to.not.have.property('passwordHash');",
                "});"
              ]}
            }
          ],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Register – Duplicate Email",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "const email = pm.collectionVariables.get('dynamicEmail');",
                "pm.request.body.update({ mode: 'raw', raw: JSON.stringify({ username: 'differentuser', name: 'Different', email, password: 'password123' }) });"
              ]}
            },
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 400 – duplicate email rejected', () => pm.response.to.have.status(400));",
              "pm.test('Error field present', () => pm.expect(pm.response.json()).to.have.property('error'));"
            ]}}
          ],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Register – Missing Fields",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"incomplete@test.com\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – missing fields rejected', () => pm.response.to.have.status(400));"
          ]}}]
        },
        {
          "name": "Login – Success",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "const username = pm.collectionVariables.get('dynamicUsername');",
                "pm.request.body.update({ mode: 'raw', raw: JSON.stringify({ username, password: 'password123' }) });"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 200 – login successful', () => pm.response.to.have.status(200));",
                "pm.test('Has token', () => {",
                "  const j = pm.response.json();",
                "  pm.expect(j).to.have.property('token');",
                "  pm.collectionVariables.set('token', j.token);",
                "});",
                "pm.test('Response time under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
              ]}
            }
          ],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Login – Wrong Password",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "const username = pm.collectionVariables.get('dynamicUsername');",
                "pm.request.body.update({ mode: 'raw', raw: JSON.stringify({ username, password: 'wrongpassword' }) });"
              ]}
            },
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 401 – wrong password rejected', () => pm.response.to.have.status(401));"
            ]}}
          ],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Login – Non-existent User",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"ghostuser_nobody\",\n  \"password\": \"anything123\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 – unknown user rejected', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "Login – Missing Password",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "const username = pm.collectionVariables.get('dynamicUsername');",
                "pm.request.body.update({ mode: 'raw', raw: JSON.stringify({ username }) });"
              ]}
            },
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 400 – missing password rejected', () => pm.response.to.have.status(400));"
            ]}}
          ],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },
    {
      "name": "Exams",
      "item": [
        {
          "name": "GET /api/exams – No Token",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/exams" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 – no token rejected', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "GET /api/exams – Authenticated",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/exams",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 – exams listed', () => pm.response.to.have.status(200));",
            "pm.test('Returns exams array', () => pm.expect(pm.response.json().exams).to.be.an('array'));",
            "pm.test('Has count field', () => pm.expect(pm.response.json()).to.have.property('count'));",
            "pm.test('Response time under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
          ]}}]
        }
      ]
    },
    {
      "name": "Resources & Smart Plan (Groq AI)",
      "item": [
        {
          "name": "GET /api/resources – Missing Topic",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/resources" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – topic required', () => pm.response.to.have.status(400));",
            "pm.test('Error field present', () => pm.expect(pm.response.json()).to.have.property('error'));"
          ]}}]
        },
        {
          "name": "GET /api/resources – With Topic",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/resources?topic=Arrays&subject=DSA" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 or 500 (Groq may be offline)', () => pm.expect([200, 500]).to.include(pm.response.code));",
            "pm.test('Returns JSON', () => pm.expect(pm.response.headers.get('content-type')).to.include('json'));",
            "if (pm.response.code === 200) {",
            "  pm.test('Has steps array', () => pm.expect(pm.response.json()).to.have.property('steps'));",
            "}"
          ]}}]
        },
        {
          "name": "POST /api/resources/plan – Missing Fields",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/resources/plan",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"DSA\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – missing fields rejected', () => pm.response.to.have.status(400));"
          ]}}]
        },
        {
          "name": "POST /api/resources/plan – Generate Study Plan",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/resources/plan",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"DSA\",\n  \"days\": 3,\n  \"hours\": 2,\n  \"level\": \"Beginner\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 or 500 (Groq may be offline)', () => pm.expect([200, 500]).to.include(pm.response.code));",
            "pm.test('Returns JSON', () => pm.expect(pm.response.headers.get('content-type')).to.include('json'));",
            "if (pm.response.code === 200) {",
            "  pm.test('Has plan array', () => pm.expect(pm.response.json()).to.have.property('plan'));",
            "}"
          ]}}]
        },
        {
          "name": "POST /api/resources/smartplan – Missing Topics",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/resources/smartplan",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – topics required', () => pm.response.to.have.status(400));",
            "pm.test('Error field present', () => pm.expect(pm.response.json()).to.have.property('error'));"
          ]}}]
        },
        {
          "name": "POST /api/resources/smartplan – Generate Smart Plan",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/resources/smartplan",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"day\": 1,\n  \"subject\": \"Deep Learning\",\n  \"hours\": 3,\n  \"topics\": [\n    { \"name\": \"LSTM – sequence modeling\", \"hours\": 1.5 },\n    { \"name\": \"Backpropagation through time\", \"hours\": 1.5 }\n  ]\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 or 500 (Groq may be offline)', () => pm.expect([200, 500]).to.include(pm.response.code));",
            "pm.test('Returns JSON', () => pm.expect(pm.response.headers.get('content-type')).to.include('json'));",
            "if (pm.response.code === 200) {",
            "  pm.test('Has overview', () => pm.expect(pm.response.json()).to.have.property('overview'));",
            "  pm.test('Has schedule', () => pm.expect(pm.response.json()).to.have.property('schedule'));",
            "  pm.test('Has tips', () => pm.expect(pm.response.json()).to.have.property('tips'));",
            "}"
          ]}}]
        }
      ]
    },
    {
      "name": "Security",
      "item": [
        {
          "name": "Invalid Token – Protected Route",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/exams",
            "header": [{ "key": "Authorization", "value": "Bearer thisisaninvalidtoken" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 – invalid token rejected', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "NoSQL Injection – Login",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": {\"$gt\": \"\"},\n  \"password\": \"anything\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('No injection bypass – not 200', () => pm.expect(pm.response.code).to.not.eql(200));",
            "pm.test('Server did not crash – not 500', () => pm.expect(pm.response.code).to.not.eql(500));"
          ]}}]
        },
        {
          "name": "404 – Unknown Route",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/nonexistent" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 – unknown route', () => pm.response.to.have.status(404));"
          ]}}]
        }
      ]
    }
  ]
}
