{
  "info": {
    "name": "Smart Learning Planner – API Tests",
    "_postman_id": "slp-api-test-collection-v1",
    "description": "Complete API test collection for Smart Learning Planner. Covers Auth, Exams, Subjects, Security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",        "value": "http://localhost:5001", "type": "string" },
    { "key": "token",          "value": "",                      "type": "string" },
    { "key": "examId",         "value": "",                      "type": "string" },
    { "key": "dynamicEmail",   "value": "",                      "type": "string" },
    { "key": "dynamicUsername","value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /api/health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ]}}]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register – Success",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "const ts = Date.now();",
                "pm.collectionVariables.set('dynamicEmail', `atharv04_${ts}@gmail.com`);",
                "pm.collectionVariables.set('dynamicUsername', `Atharv Singh Rawat_${ts}`);"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 201 – user created', () => pm.response.to.have.status(201));",
                "pm.test('Has token', () => {",
                "  const j = pm.response.json();",
                "  pm.expect(j).to.have.property('token');",
                "  pm.collectionVariables.set('token', j.token);",
                "});",
                "pm.test('User email matches', () => {",
                "  const j = pm.response.json();",
                "  pm.expect(j.user.email).to.eql(pm.collectionVariables.get('dynamicEmail'));",
                "});"
              ]}
            }
          ],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{dynamicUsername}}\",\n  \"name\": \"Atharv Singh Rawat\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"password\": \"atharv04\"\n}" }
          }
        },
        {
          "name": "Register – Duplicate Email",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"Test Duplicate\",\n  \"name\": \"Test Duplicate\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"password\": \"atharv04\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – duplicate email rejected', () => pm.response.to.have.status(400));",
            "pm.test('Error field present', () => pm.expect(pm.response.json()).to.have.property('error'));"
          ]}}]
        },
        {
          "name": "Register – Missing Fields",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"incomplete@test.com\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – missing fields rejected', () => pm.response.to.have.status(400));"
          ]}}]
        },
        {
          "name": "Login – Success",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{dynamicUsername}}\",\n  \"password\": \"atharv04\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 – login successful', () => pm.response.to.have.status(200));",
            "pm.test('Has token', () => {",
            "  const j = pm.response.json();",
            "  pm.expect(j).to.have.property('token');",
            "  pm.collectionVariables.set('token', j.token);",
            "});",
            "pm.test('Response time under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
          ]}}]
        },
        {
          "name": "Login – Wrong Password",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{dynamicUsername}}\",\n  \"password\": \"wrongpassword\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 – wrong password rejected', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "Login – Non-existent User",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"ghostuser_nobody\",\n  \"password\": \"anything123\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 – unknown user rejected', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "Login – Missing Fields",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{dynamicUsername}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – missing password rejected', () => pm.response.to.have.status(400));"
          ]}}]
        }
      ]
    },
    {
      "name": "Exams",
      "item": [
        {
          "name": "GET /api/exams – No Token",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/exams" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 – no token rejected', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "POST /api/exams – Create Exam",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/exams",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"examName\": \"Mathematics Final\",\n  \"examDate\": \"2026-12-01\",\n  \"targetScore\": 85\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201 – exam created', () => pm.response.to.have.status(201));",
            "pm.test('Exam name is correct', () => {",
            "  const j = pm.response.json();",
            "  pm.expect(j.exam.examName).to.eql('Mathematics Final');",
            "  pm.collectionVariables.set('examId', j.exam._id);",
            "});",
            "pm.test('Target score is 85', () => pm.expect(pm.response.json().exam.targetScore).to.eql(85));"
          ]}}]
        },
        {
          "name": "POST /api/exams – Missing examName",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/exams",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"examDate\": \"2026-12-01\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – missing name rejected', () => pm.response.to.have.status(400));"
          ]}}]
        },
        {
          "name": "POST /api/exams – Invalid Date",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/exams",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"examName\": \"Test Exam\",\n  \"examDate\": \"not-a-date\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – invalid date rejected', () => pm.response.to.have.status(400));"
          ]}}]
        },
        {
          "name": "POST /api/exams – Score 101 (Boundary)",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/exams",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"examName\": \"Boundary Test\",\n  \"examDate\": \"2026-12-01\",\n  \"targetScore\": 101\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – score above 100 rejected', () => pm.response.to.have.status(400));"
          ]}}]
        },
        {
          "name": "GET /api/exams – List",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/exams",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 – exams listed', () => pm.response.to.have.status(200));",
            "pm.test('Returns array', () => pm.expect(pm.response.json().exams).to.be.an('array'));",
            "pm.test('Response time under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
          ]}}]
        }
      ]
    },
    {
      "name": "Subjects",
      "item": [
        {
          "name": "POST /api/subjects – Create",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/subjects",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"examId\": \"{{examId}}\",\n  \"subjectName\": \"Organic Chemistry\",\n  \"difficulty\": \"hard\",\n  \"isWeak\": true\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201 – subject created', () => pm.response.to.have.status(201));",
            "pm.test('Subject name correct', () => pm.expect(pm.response.json().subject.subjectName).to.eql('Organic Chemistry'));"
          ]}}]
        },
        {
          "name": "POST /api/subjects – Invalid Difficulty",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/subjects",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"examId\": \"{{examId}}\",\n  \"subjectName\": \"Physics\",\n  \"difficulty\": \"extreme\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 – invalid difficulty rejected', () => pm.response.to.have.status(400));"
          ]}}]
        },
        {
          "name": "GET /api/subjects – List",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/subjects",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 – subjects listed', () => pm.response.to.have.status(200));",
            "pm.test('Returns array', () => pm.expect(pm.response.json().subjects).to.be.an('array'));"
          ]}}]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "DELETE /api/exams/:id",
          "request": {
            "method": "DELETE", "url": "{{baseUrl}}/api/exams/{{examId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 – exam deleted', () => pm.response.to.have.status(200));"
          ]}}]
        }
      ]
    },
    {
      "name": "Security",
      "item": [
        {
          "name": "Invalid Token",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/exams",
            "header": [{ "key": "Authorization", "value": "Bearer thisisaninvalidtoken" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 – invalid token rejected', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "NoSQL Injection – Login",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": {\"$gt\": \"\"},\n  \"password\": \"anything\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('No injection bypass – not 200', () => pm.expect(pm.response.code).to.not.eql(200));",
            "pm.test('Server did not crash – not 500', () => pm.expect(pm.response.code).to.not.eql(500));"
          ]}}]
        },
        {
          "name": "404 – Unknown Route",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/nonexistent" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 – unknown route', () => pm.response.to.have.status(404));"
          ]}}]
        }
      ]
    }
  ]
}
